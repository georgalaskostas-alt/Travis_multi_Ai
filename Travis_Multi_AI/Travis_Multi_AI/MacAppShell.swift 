import SwiftUI

struct MacAppShell: View {
    @Bindable var appState: TRAVISAppState

    var body: some View {
        NavigationSplitView {
            List(SidebarItem.allCases, selection: selectionBinding) { item in
                Label(item.title, systemImage: icon(for: item))
                    .tag(item)
            }
            .navigationTitle("TRAVIS")
            .navigationSplitViewColumnWidth(min: 180, ideal: 220)
        } detail: {
            ZStack {
                detailView(for: appState.selectedSidebarItem)
            }
            .frame(maxWidth: .infinity, maxHeight: .infinity)
        }
        .preferredColorScheme(.dark)
    }

    private var selectionBinding: Binding<SidebarItem?> {
        Binding(
            get: { appState.selectedSidebarItem },
            set: { newValue in
                if let newValue {
                    appState.selectedSidebarItem = newValue
                }
            }
        )
    }

    @ViewBuilder
    private func detailView(for item: SidebarItem) -> some View {
        switch item {
        case .chat:
            ChatView(appState: appState)
        case .tasks:
            taskPanel
        case .crypto:
            CryptoTradingView(appState: appState)
        case .permissions:
            PermissionsView(appState: appState)
        case .settings:
            SettingsView(appState: appState)
        }
    }

    private var taskPanel: some View {
        List(appState.activeTasks) { task in
            VStack(alignment: .leading, spacing: 6) {
                Text(task.title)
                    .font(.headline)

                Text(task.details)
                    .font(.subheadline)
                    .foregroundStyle(.secondary)

                Text("\(task.status.rawValue) • \(task.priority.rawValue)")
                    .font(.caption)
                    .foregroundStyle(.cyan)
            }
            .padding(.vertical, 4)
        }
        .navigationTitle("Tasks")
    }

    private func icon(for item: SidebarItem) -> String {
        switch item {
        case .chat: return "message"
        case .tasks: return "checklist"
        case .crypto: return "bitcoinsign.circle"
        case .permissions: return "lock.shield"
        case .settings: return "gearshape"
        }
    }
}
